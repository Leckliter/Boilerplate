# --- Pick ONE backend. Delete the other provider's block (and its adapter folder) when you commit to one.
BACKEND=neon            # neon | supabase
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Neon (BACKEND=neon)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Supabase (BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# S3-compatible storage (Neon Object Storage or Supabase Storage S3 endpoint)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# Email / SMS
RESEND_API_KEY=
QUO_API_KEY=
# Provider webhooks (docs/notifications.md → Webhooks). Resend: the `whsec_…` signing secret of the webhook
# pointing at /api/webhooks/resend. Quo: the signing key of the webhook pointing at /api/webhooks/quo.
RESEND_WEBHOOK_SECRET=
QUO_WEBHOOK_SECRET=
# Web Push (VAPID): `npx web-push generate-vapid-keys`; the subject is a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TEST_RECIPIENTS_EMAIL=
TEST_RECIPIENTS_SMS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWNER_EMAILS=you@example.com
CRON_SECRET=
EMAIL_FROM=
NOTIFICATIONS_SECRET=
AUTOMATIONS_WEBHOOK_SECRET=
APP_NAME=My App
APP_TIME_ZONE=America/Chicago
# Server log level: debug | info | warn | error | silent (default info). One JSON object per line.
LOG_LEVEL=info
# Local dev only (never in production): sign in as any email with code 000000
DEV_LOGIN=
