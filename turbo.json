{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_*",
        "BACKEND",
        "SUPABASE_*",
        "NEON_*",
        "S3_*",
        "RESEND_*",
        "QUO_*",
        "EMAIL_FROM",
        "APP_NAME",
        "APP_TIME_ZONE",
        "NOTIFICATIONS_SECRET",
        "VAPID_*",
        "LOG_LEVEL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
